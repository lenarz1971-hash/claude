{
 "capability": "<div class=\"tool\" id=\"capability\">\n      <div class=\"tool-h\"><h3>Process capability</h3>\n        <span class=\"hint\">Cp &middot; Cpk &middot; Pp &middot; Ppk &middot; PPM &middot; SIGMA LEVEL</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <label>MEASUREMENTS</label>\n            <div id=\"capGrid\" class=\"dgmount\"></div>\n            <div class=\"fields\" style=\"margin-top:14px\">\n              <div><label for=\"capLSL\">LSL</label><input type=\"number\" id=\"capLSL\" step=\"any\" value=\"1.990\"></div>\n              <div><label for=\"capUSL\">USL</label><input type=\"number\" id=\"capUSL\" step=\"any\" value=\"2.010\"></div>\n              <div><label for=\"capSub\">SUBGROUP SIZE</label><input type=\"number\" id=\"capSub\" min=\"1\" max=\"10\" value=\"4\"></div>\n            </div>\n            <div class=\"btnrow\" style=\"margin-top:16px\">\n              <button class=\"btn sm\" id=\"capRun\" type=\"button\">Calculate</button>\n              <button class=\"btn sm ghost\" id=\"capDemo\" type=\"button\">Reset to the example</button>\n            </div>\n          </div>\n          <div>\n            <div class=\"plot\" id=\"capPlot\"></div>\n            <div id=\"capOut\" hidden>\n              <div class=\"readout\">\n                <div class=\"ro\"><span class=\"v\" id=\"capCp\">&mdash;</span><span class=\"k\">Cp</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"capCpk\">&mdash;</span><span class=\"k\">Cpk</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"capPp\">&mdash;</span><span class=\"k\">Pp</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"capPpk\">&mdash;</span><span class=\"k\">Ppk</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"capPpm\">&mdash;</span><span class=\"k\">PPM OUT</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"capSig\">&mdash;</span><span class=\"k\">SIGMA LEVEL</span></div>\n              </div>\n              <p style=\"font:400 11.5px/1.7 var(--mono);color:var(--chalk-2);margin-top:14px\" id=\"capStats\"></p>\n            </div>\n          </div>\n        </div>\n        <div class=\"verdict\" id=\"capVerdict\">Paste measurements and set the limits, or load the worked example.</div>\n      </div>\n    </div>",
 "spc": "<div class=\"tool\" id=\"spc\">\n      <div class=\"tool-h\"><h3>Control chart builder</h3>\n        <span class=\"hint\">X&#772;-R OR I-MR &middot; CONSTANTS COMPUTED &middot; RUN RULES APPLIED</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <label for=\"spcData\">ONE SUBGROUP PER LINE &mdash; A SINGLE COLUMN GIVES AN I-MR CHART</label>\n            <div id=\"spcGrid\" class=\"dgmount\"></div>\n            <div class=\"btnrow\" style=\"margin-top:14px\">\n              <button class=\"btn sm\" id=\"spcRun\" type=\"button\">Build the chart</button>\n              <button class=\"btn sm ghost\" id=\"spcDemo\" type=\"button\">Reset to the example</button>\n            </div>\n            <div id=\"spcOut\" hidden>\n              <p class=\"rolabel\" id=\"spcLblX\">THE MEANS CHART</p>\n              <div class=\"readout\">\n                <div class=\"ro\"><span class=\"v\" id=\"spcXbar\">&mdash;</span><span class=\"k\">CENTER LINE</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcUCL\">&mdash;</span><span class=\"k\">UPPER LIMIT</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcLCL\">&mdash;</span><span class=\"k\">LOWER LIMIT</span></div>\n              </div>\n              <p class=\"rolabel\" id=\"spcLblR\">THE RANGE CHART</p>\n              <div class=\"readout\">\n                <div class=\"ro\"><span class=\"v\" id=\"spcRbar\">&mdash;</span><span class=\"k\">CENTER LINE, R&#772;</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcUCLR\">&mdash;</span><span class=\"k\">UPPER LIMIT</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcLCLR\">&mdash;</span><span class=\"k\">LOWER LIMIT</span></div>\n              </div>\n              <div class=\"readout\" style=\"margin-top:14px\">\n                <div class=\"ro\"><span class=\"v\" id=\"spcSig\">&mdash;</span><span class=\"k\">&sigma; FROM R&#772;/d&#8322;</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcFlags\">&mdash;</span><span class=\"k\">SIGNALS</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"spcSub\">&mdash;</span><span class=\"k\" id=\"spcSubK\">SUBGROUPS</span></div>\n              </div>\n              <p style=\"font:400 11px/1.7 var(--mono);color:var(--chalk-2);margin-top:14px\" id=\"spcBasis\"></p>\n            </div>\n          </div>\n          <div>\n            <div class=\"plot\" id=\"spcPlotX\" style=\"margin-bottom:14px\"></div>\n            <div class=\"plot\" id=\"spcPlotR\"></div>\n          </div>\n        </div>\n        <div class=\"verdict\" id=\"spcVerdict\">Paste subgroups, or load the worked example.</div>\n        <table class=\"dtbl\"><thead><tr><th>SUBGROUP</th><th>VALUE</th><th>SIGNAL</th></tr></thead>\n          <tbody id=\"spcRules\"></tbody></table>\n      </div>\n    </div>",
 "grr": "<div class=\"tool\" id=\"grr\">\n      <div class=\"tool-h\"><h3>Gauge R&amp;R</h3>\n        <span class=\"hint\">AVERAGE AND RANGE METHOD &middot; %EV, %AV, %R&amp;R, ndc</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <label for=\"grrData\">ONE LINE PER OPERATOR AND PART: OPERATOR, PART, TRIAL 1, TRIAL 2 &hellip;</label>\n            <div id=\"grrGrid\" class=\"dgmount\"></div>\n            <div class=\"btnrow\" style=\"margin-top:14px\">\n              <button class=\"btn sm\" id=\"grrRun\" type=\"button\">Run the study</button>\n              <button class=\"btn sm ghost\" id=\"grrDemo\" type=\"button\">Reset to the example</button>\n            </div>\n          </div>\n          <div>\n            <div id=\"grrOut\" hidden>\n              <div class=\"readout\">\n                <div class=\"ro\"><span class=\"v\" id=\"grrEV\">&mdash;</span><span class=\"k\">%EV REPEATABILITY</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"grrAV\">&mdash;</span><span class=\"k\">%AV REPRODUCIBILITY</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"grrRR\">&mdash;</span><span class=\"k\">%R&amp;R</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"grrPV\">&mdash;</span><span class=\"k\">%PV PART</span></div>\n                <div class=\"ro\"><span class=\"v\" id=\"grrNDC\">&mdash;</span><span class=\"k\">ndc</span></div>\n              </div>\n              <p style=\"font:400 11px/1.7 var(--mono);color:var(--chalk-2);margin-top:14px\" id=\"grrBasis\"></p>\n            </div>\n            <div class=\"cal ce\" style=\"margin-top:18px;background:rgba(255,74,52,.08);border-left-color:var(--signal)\">\n              <span class=\"cal-t\" style=\"color:var(--signal)\">COMMON ERROR</span>\n              <p style=\"color:var(--chalk-2);font-size:15px\">Reading %R&amp;R as a pass mark. The bands are a\n                convention, not a rule: a system at 25 percent may be fine for a loose characteristic and useless\n                for a tight one. Look at ndc and at which component dominates before deciding anything.</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"verdict\" id=\"grrVerdict\">Enter a study, or load the worked example.</div>\n      </div>\n    </div>",
 "sigma": "<div class=\"tool\" id=\"sigma\">\n      <div class=\"tool-h\"><h3>Sigma level, DPMO and yield</h3>\n        <span class=\"hint\">1.5&sigma; LONG-TERM SHIFT APPLIED</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <label for=\"sigRange\">PROCESS SIGMA LEVEL</label>\n            <input type=\"range\" id=\"sigRange\" min=\"10\" max=\"60\" step=\"1\" value=\"30\">\n            <div class=\"ticks\"><span>1&sigma;</span><span>2&sigma;</span><span>3&sigma;</span><span>4&sigma;</span><span>5&sigma;</span><span>6&sigma;</span></div>\n            <div class=\"readout\">\n              <div class=\"ro\"><span class=\"v\" id=\"sigLevel\">3.0&sigma;</span><span class=\"k\">SIGMA LEVEL</span></div>\n              <div class=\"ro\"><span class=\"v\" id=\"sigDpmo\">66,807</span><span class=\"k\">DPMO</span></div>\n              <div class=\"ro\"><span class=\"v\" id=\"sigYield\">93.32%</span><span class=\"k\">YIELD</span></div>\n            </div>\n            <p style=\"font:400 13.5px/1.6 var(--serif);color:var(--chalk-2);margin-top:18px\" id=\"sigNote\"></p>\n          </div>\n          <div class=\"plot\" id=\"sigPlot\"></div>\n        </div>\n      </div>\n    </div>",
 "pareto": "<div class=\"tool\" id=\"pareto\">\n      <div class=\"tool-h\"><h3>Pareto builder</h3>\n        <span class=\"hint\">SORTS, CUMULATES, AND TESTS FOR A VITAL FEW</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <label for=\"parData\">ONE LINE PER CATEGORY: NAME, COUNT</label>\n            <div id=\"parGrid\" class=\"dgmount\"></div>\n            <div class=\"btnrow\" style=\"margin-top:14px\">\n              <button class=\"btn sm\" id=\"parRun\" type=\"button\">Build it</button>\n              <button class=\"btn sm ghost\" id=\"parDemo\" type=\"button\">Reset to the example</button>\n            </div>\n            <div id=\"parOut\" hidden>\n              <table class=\"dtbl\"><thead><tr><th>CATEGORY</th><th>COUNT</th><th>SHARE</th><th>CUMULATIVE</th></tr></thead>\n                <tbody id=\"parTable\"></tbody></table>\n            </div>\n          </div>\n          <div class=\"plot\" id=\"parPlot\"></div>\n        </div>\n        <div class=\"verdict\" id=\"parVerdict\">Enter categories and counts, or load the worked example.</div>\n      </div>\n    </div>",
 "oc": "<div class=\"tool\" id=\"oc\">\n      <div class=\"tool-h\"><h3>Sampling plan and OC curve</h3>\n        <span class=\"hint\">BINOMIAL &middot; PRODUCER AND CONSUMER RISK</span></div>\n      <div class=\"tool-b\">\n        <div class=\"grid2\">\n          <div>\n            <div class=\"fields two\">\n              <div><label for=\"ocN\">SAMPLE SIZE n</label><input type=\"number\" id=\"ocN\" min=\"1\" value=\"80\"></div>\n              <div><label for=\"ocC\">ACCEPT ON c</label><input type=\"number\" id=\"ocC\" min=\"0\" value=\"1\"></div>\n              <div><label for=\"ocAQL\">AQL %</label><input type=\"number\" id=\"ocAQL\" step=\"0.01\" value=\"1\"></div>\n              <div><label for=\"ocRQL\">RQL / LTPD %</label><input type=\"number\" id=\"ocRQL\" step=\"0.01\" value=\"6\"></div>\n            </div>\n            <div class=\"readout\">\n              <div class=\"ro\"><span class=\"v\" id=\"ocAlpha\">&mdash;</span><span class=\"k\">&alpha; PRODUCER RISK</span></div>\n              <div class=\"ro\"><span class=\"v\" id=\"ocBeta\">&mdash;</span><span class=\"k\">&beta; CONSUMER RISK</span></div>\n              <div class=\"ro\"><span class=\"v\" id=\"ocIQ\">&mdash;</span><span class=\"k\">50% ACCEPT POINT</span></div>\n              <div class=\"ro\"><span class=\"v\" id=\"ocRatio\">&mdash;</span><span class=\"k\">DISCRIMINATION</span></div>\n            </div>\n            <p style=\"font:400 12px/1.7 var(--mono);color:var(--chalk-2);margin-top:14px\">\n              CURVE COMPUTED FROM THE BINOMIAL DISTRIBUTION. NOT A REPRODUCTION OF ANY PUBLISHED SAMPLING STANDARD\n              &mdash; USE THE STANDARD ITSELF WHEN A PLAN IS CONTRACTUALLY REQUIRED.</p>\n          </div>\n          <div class=\"plot\" id=\"ocPlot\"></div>\n        </div>\n        <div class=\"verdict\" id=\"ocVerdict\"></div>\n      </div>\n    </div>",
 "constants": "<div class=\"tool\" id=\"constants\">\n      <div class=\"tool-h\"><h3>Control chart constants</h3>\n        <span class=\"hint\">DERIVED ON PAGE LOAD FROM THE DISTRIBUTION OF THE RANGE</span></div>\n      <div class=\"tool-b\">\n        <p style=\"color:var(--chalk-2);max-width:64ch;font-size:16px\">These are not transcribed. When this page\n          loaded, your browser integrated the distribution of the range of <em>n</em> standard normal variables to\n          get d&#8322; and d&#8323;, then formed the chart factors from them. Check any row against your own table\n          &mdash; agreement to four decimals is the point.</p>\n        <table class=\"dtbl\" style=\"max-width:720px\">\n          <thead><tr><th>n</th><th>d&#8322;</th><th>d&#8323;</th><th>A&#8322;</th><th>D&#8323;</th><th>D&#8324;</th><th>3/(d&#8322;&radic;n)</th></tr></thead>\n          <tbody id=\"ccTable\"></tbody>\n        </table>\n        <p style=\"font:400 11.5px/1.7 var(--mono);color:var(--chalk-2);margin-top:16px;max-width:70ch\">\n          d&#8322; = E[W] AND d&#8323; = SD[W], WHERE W IS THE RANGE OF n STANDARD NORMAL VARIABLES.\n          A&#8322; = 3 / (d&#8322;&radic;n).  D&#8323; = max(0, 1 &minus; 3d&#8323;/d&#8322;).  D&#8324; = 1 + 3d&#8323;/d&#8322;.</p>\n      </div>\n    </div>",
 "yield": "<div class=\"tool\" id=\"yield\">\n  <div class=\"tool-h\"><h3>Yield, DPMO and sigma</h3>\n    <span class=\"hint\">RTY &middot; NORMALIZED YIELD &middot; DPU &middot; HIDDEN FACTORY</span></div>\n  <div class=\"tool-b\">\n    <div class=\"grid2\">\n      <div>\n        <label for=\"yStepData\">ONE PROCESS STEP PER LINE: NAME, UNITS IN, DEFECTS</label>\n        <div id=\"yGrid\" class=\"dgmount\"></div>\n        <div class=\"fields\" style=\"margin-top:14px\">\n          <div><label for=\"yOpp\">OPPORTUNITIES PER UNIT</label><input type=\"number\" id=\"yOpp\" min=\"1\" value=\"5\"></div>\n        </div>\n        <div class=\"btnrow\" style=\"margin-top:14px\">\n          <button class=\"btn sm\" id=\"yRun\" type=\"button\">Calculate</button>\n          <button class=\"btn sm ghost\" id=\"yDemo\" type=\"button\">Reset to the example</button>\n        </div>\n        <div id=\"yOut\" hidden>\n          <div class=\"readout\">\n            <div class=\"ro\"><span class=\"v\" id=\"yRTY\">&mdash;</span><span class=\"k\">ROLLED THROUGHPUT YIELD</span></div>\n            <div class=\"ro\"><span class=\"v\" id=\"yNorm\">&mdash;</span><span class=\"k\">NORMALIZED YIELD</span></div>\n            <div class=\"ro\"><span class=\"v\" id=\"yDPU\">&mdash;</span><span class=\"k\">DEFECTS PER UNIT</span></div>\n            <div class=\"ro\"><span class=\"v\" id=\"yDPMO\">&mdash;</span><span class=\"k\">DPMO</span></div>\n            <div class=\"ro\"><span class=\"v\" id=\"ySigma\">&mdash;</span><span class=\"k\">SIGMA LEVEL</span></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"plot\" id=\"yPlot\"></div>\n    </div>\n    <div class=\"verdict\" id=\"yVerdict\"></div>\n  </div>\n</div>",
 "samplesize": "<div class=\"tool\" id=\"samplesize\">\n  <div class=\"tool-h\"><h3>Sample size</h3>\n    <span class=\"hint\">ATTRIBUTE OR VARIABLE &middot; FINITE POPULATION CORRECTION</span></div>\n  <div class=\"tool-b\">\n    <div class=\"grid2\">\n      <div>\n        <div class=\"fields two\">\n          <div><label for=\"ssMode\">ESTIMATING</label>\n            <select id=\"ssMode\"><option value=\"attr\">A proportion (attribute)</option>\n              <option value=\"var\">A mean (variable)</option></select></div>\n          <div><label for=\"ssConf\">CONFIDENCE %</label><input type=\"number\" id=\"ssConf\" step=\"0.5\" value=\"95\"></div>\n        </div>\n        <div class=\"fields two\" id=\"ssAttrFields\" style=\"margin-top:14px\">\n          <div><label for=\"ssP\">EXPECTED PROPORTION %</label><input type=\"number\" id=\"ssP\" step=\"0.1\" value=\"50\"></div>\n          <div><label for=\"ssE\">MARGIN OF ERROR &plusmn;%</label><input type=\"number\" id=\"ssE\" step=\"0.1\" value=\"5\"></div>\n        </div>\n        <div class=\"fields two\" id=\"ssVarFields\" style=\"margin-top:14px\" hidden>\n          <div><label for=\"ssSD\">ESTIMATED &sigma;</label><input type=\"number\" id=\"ssSD\" step=\"any\" value=\"0.0020\"></div>\n          <div><label for=\"ssME\">MARGIN OF ERROR &plusmn;</label><input type=\"number\" id=\"ssME\" step=\"any\" value=\"0.0005\"></div>\n        </div>\n        <div class=\"fields\" style=\"margin-top:14px\">\n          <div><label for=\"ssPop\">POPULATION SIZE (OPTIONAL)</label><input type=\"number\" id=\"ssPop\" min=\"1\" placeholder=\"leave blank if large\"></div>\n        </div>\n      </div>\n      <div>\n        <div class=\"readout\" style=\"margin-top:0\">\n          <div class=\"ro\"><span class=\"v\" id=\"ssN\">&mdash;</span><span class=\"k\">SAMPLE SIZE</span></div>\n          <div class=\"ro\"><span class=\"v\" id=\"ssNAdj\">&mdash;</span><span class=\"k\">WITH FPC</span></div>\n          <div class=\"ro\"><span class=\"v\" id=\"ssZ\">&mdash;</span><span class=\"k\">z VALUE</span></div>\n        </div>\n        <p style=\"font:500 11.5px/1.7 var(--mono);letter-spacing:.04em;color:var(--ink-3);margin-top:14px\" id=\"ssBasis\"></p>\n      </div>\n    </div>\n    <div class=\"verdict\" id=\"ssVerdict\"></div>\n  </div>\n</div>",
 "grrcpk": "<div class=\"tool\" id=\"grrcpk\">\n      <div class=\"tool-h\"><h3>What gauge R&amp;R does to Cpk</h3>\n        <span class=\"hint\">MEASURED VARIATION = ACTUAL + MEASUREMENT SYSTEM</span></div>\n      <div class=\"tool-b\">\n        <p style=\"margin-bottom:6px\">Variances add. The spread you measure is the process spread\n          and the gauge spread together, and Cpk is calculated from what you measured &mdash; so\n          every Cpk you have ever reported was lower than the process deserved.</p>\n\n        <div class=\"eqn\" id=\"gcEqn\"></div>\n\n        <div class=\"sliders\" style=\"margin-top:20px\">\n          <div class=\"sl\">\n            <label for=\"gcCpk\">TRUE Cpk <b id=\"gcCpkV\">1.33</b></label>\n            <input type=\"range\" id=\"gcCpk\" min=\"0.5\" max=\"2.5\" step=\"0.01\" value=\"1.33\">\n            <span class=\"ends\"><i>0.50</i><i>2.50</i></span>\n          </div>\n          <div class=\"sl\">\n            <label for=\"gcGrr\">GAUGE R&amp;R <b id=\"gcGrrV\">30%</b></label>\n            <input type=\"range\" id=\"gcGrr\" min=\"0\" max=\"80\" step=\"1\" value=\"30\">\n            <span class=\"ends\"><i>0%</i><i>30%</i><i>80%</i></span>\n          </div>\n        </div>\n\n        <div class=\"plot\" id=\"gcPlot\"></div>\n        <div class=\"gclegend\">\n          <span><i class=\"sw\" style=\"background:#0F3E68\"></i>Actual process variation</span>\n          <span><i class=\"sw\" style=\"background:#C0392B\"></i>Measured variation</span>\n          <span><i class=\"sw\" style=\"background:#C0392B;opacity:.22;height:11px\"></i>What the gauge added</span>\n          <span><i class=\"sw\" style=\"background:#9C7C1F\"></i>Specification limits</span>\n        </div>\n        <p class=\"note\" id=\"gcZone\" style=\"margin-top:12px\"></p>\n\n        <div class=\"statrow\" id=\"gcStats\" style=\"margin-top:20px\"></div>\n        <div class=\"verdict\" id=\"gcVerdict\"></div>\n\n        <div class=\"grid2\" style=\"margin-top:20px\">\n          <div>\n            <h4 style=\"margin:0 0 8px\">Wrong decisions, per million parts</h4>\n            <div id=\"gcMis\"></div>\n          </div>\n          <div class=\"callout\">\n            <b>Why the curve moves so little at first.</b> Variances add, not standard deviations,\n            so the gauge has to be large before it shifts the total much. A 30 percent gauge\n            widens the measured curve by under five percent. Push the slider past fifty and the\n            two curves pull apart in a hurry &mdash; that is quadrature, arriving late and all at\n            once.\n          </div>\n        </div>\n\n        <div class=\"callout\" style=\"margin-top:16px;border-left-color:var(--navy);background:var(--navy-xl)\">\n          <b>The arithmetic.</b> With %GRR expressed against total variation, observed Cpk works\n          out to exactly &radic;(1 &minus; %GRR&sup2;) times the true Cpk. Ten percent costs you\n          half a percent of Cpk, thirty costs you five, fifty costs thirteen, and eighty costs you\n          forty.\n        </div>\n      </div>\n    </div>",
 "linearity": "<div class=\"tool\" id=\"linearity\">\n      <div class=\"tool-h\"><h3>Linearity study</h3>\n        <span class=\"hint\">%EV AT EACH REFERENCE &middot; POOLED &middot; LINEARITY ACROSS THE RANGE</span></div>\n      <div class=\"tool-b\">\n        <p style=\"margin-bottom:16px\">One appraiser, several certified references spread across the\n          operating range, repeated readings on each. The result to read is <b>%EV</b> &mdash; how\n          much of the part tolerance the gauge&rsquo;s own scatter consumes, at each reference and\n          pooled across the range. The linearity test below asks a second question: whether that\n          accuracy holds from one end of the range to the other.</p>\n\n        <div class=\"fields\" style=\"margin-bottom:16px\">\n          <div><label for=\"linConf\">CONFIDENCE</label>\n            <select id=\"linConf\">\n              <option value=\"0.90\">90%</option>\n              <option value=\"0.95\" selected>95%</option>\n              <option value=\"0.99\">99%</option>\n            </select></div>\n          <div><label for=\"linK\">STUDY VARIATION k</label>\n            <select id=\"linK\">\n              <option value=\"6\" selected>6.00 &mdash; 99.73% (MSA 4th ed.)</option>\n              <option value=\"5.15\">5.15 &mdash; 99% (MSA 3rd ed. and earlier)</option>\n            </select></div>\n          <div><label for=\"linCut\">PRACTICAL BIAS CUTOFF %</label>\n            <input type=\"number\" id=\"linCut\" step=\"1\" value=\"10\"></div>\n        </div>\n\n        <label>REFERENCES &mdash; CERTIFIED VALUE, THEN THE READINGS</label>\n        <div id=\"linGrid\" class=\"dgmount\"></div>\n        <p class=\"note\" style=\"margin-top:10px\">One row per reference. Specification limits are per\n          reference because each block stands for a different product band; leave them blank and the\n          %EV columns read &ldquo;n/a&rdquo;. Blank readings are ignored.</p>\n        <p class=\"note\" style=\"margin-top:8px\"><b>k decides how much of the gauge&rsquo;s scatter is\n          charged against the tolerance</b>, and the two values are conventions rather than choices:\n          6.00 covers 99.73 percent and is the MSA 4th edition default, 5.15 covers 99 percent and\n          appears in older customer agreements. Switching knocks about fourteen percent off every\n          %EV figure, so state which you used.</p>\n\n        <div class=\"btnrow\" style=\"margin-top:14px\">\n          <button class=\"btn\" id=\"linRun\" type=\"button\">Run the study</button>\n          <button class=\"btn ghost\" id=\"linEx\" type=\"button\">Worked example</button>\n        </div>\n\n        <div class=\"verdict\" id=\"linVerdict\" hidden></div>\n        <div id=\"linOut\" hidden>\n          <div class=\"statrow\" id=\"linStats\"></div>\n          <h4 style=\"margin:22px 0 8px\">Repeatability at each reference</h4>\n          <div style=\"overflow-x:auto\"><div id=\"linPerRef\"></div></div>\n          <h4 style=\"margin:26px 0 8px\">Linearity across the range</h4>\n          <div style=\"overflow-x:auto\"><div id=\"linReg\"></div></div>\n          <h4 style=\"margin:26px 0 8px\">Linearity plot</h4>\n          <div class=\"plot\" id=\"linPlot\"></div>\n          <h4 style=\"margin:26px 0 8px\">Band check</h4>\n          <div style=\"overflow-x:auto\"><div id=\"linBands\"></div></div>\n          <div class=\"callout\" style=\"margin-top:20px\">\n            <b>What this study does not tell you.</b> One appraiser means there is no\n            reproducibility, no part variation, no %GRR and no number of distinct categories. Those\n            come from a gauge R&amp;R study. This is the linearity method from the basic variable\n            chapter of the MSA manual &mdash; if your measurement is genuinely non-replicable, the\n            manual sends you to a nested or pooled standard deviation approach instead.\n          </div>\n        </div>\n      </div>\n    </div>",
 "hypothesis": "<div class=\"tool\" id=\"hypothesis\">\n  <div class=\"tool-h\"><h3>Hypothesis test selector</h3>\n    <span class=\"hint\">ANSWER FOUR QUESTIONS, GET THE RIGHT TEST</span></div>\n  <div class=\"tool-b\">\n    <p style=\"max-width:62ch;margin-bottom:22px\">Choosing the wrong test is more common than computing the\n      right one incorrectly, and it is examined directly on the Green Belt, Black Belt and Quality Engineer\n      papers. Work down the tree; the reasoning is printed with the answer.</p>\n    <div id=\"htBody\"></div>\n  </div>\n</div>"
}